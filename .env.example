# ── إعدادات اللوحة ─────────────────────────────────────────
# المنفذ الذي تعمل عليه اللوحة
PORT=8080

# مسار مجلد سيرفر Minecraft (فيه ملف الـ jar والعوالم world/)
# لا يجب أن يكون نفس مجلد اللوحة
MC_DIR=/opt/minecraft

# اسم ملف السيرفر (jar) بالضبط كما هو داخل MC_DIR
MC_JAR=spigot-26.3.jar

# اسم جلسة tmux التي يشتغل بها السيرفر
TMUX_SESSION=mcserver

# مفتاح تشفير الجلسات (سيشن). لو تركته فاضي بيتولد عشوائي كل مرة
# تشغّل فيها اللوحة، وهذا يعني تسجيل خروج الجميع بعد كل إعادة تشغيل.
# لتوليد واحد: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── بيانات تسجيل الدخول ────────────────────────────────────
ADMIN_USER=admin

# كلمة مرور نصية عادية (تُستخدم فقط لو ADMIN_HASH فاضي)
ADMIN_PASS=change-me

# (اختياري) بدل ADMIN_PASS: حط هاش bcrypt جاهز للباسورد بدل النص الصريح
# لتوليده: node -e "console.log(require('bcryptjs').hashSync('كلمة-المرور', 12))"
# لو حطيت ADMIN_HASH، لازم تشيل أو تتجاهل ADMIN_PASS
ADMIN_HASH=

# ── خيارات إضافية (اختيارية) ───────────────────────────────
# اسم السيرفر الذي يظهر في رسائل التنبيهات (افتراضي: اسم مجلد MC_DIR)
SERVER_NAME=

# اجعل كوكي الجلسة يُرسل عبر HTTPS فقط. استعمل auto خلف Caddy/nginx (مع تفعيل HTTPS)، أو true إذا كانت اللوحة نفسها على HTTPS
COOKIE_SECURE=

# مسار برنامج rclone للنسخ الاحتياطي الخارجي (افتراضي: rclone من PATH)
RCLONE_BIN=
